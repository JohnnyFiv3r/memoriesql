  "implementation_scope": {
    "gap_semantics": "Apply ea-6: schema-39 callers outside AM-5 without raw authority retain relation_tables/source_raw_read_required. Agent-mode callers missing source.read get relation_tables/source_read_required. Agent history/pair reads retain relation_history/owner_only. No mode or withheld counts are disclosed.",
