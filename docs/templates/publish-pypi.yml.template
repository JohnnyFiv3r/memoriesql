# NON-LIVE TEMPLATE. Keep outside .github/workflows.
# Do not activate or register a Trusted Publisher until the repository is public
# and the owner approves the final repository, workflow filename, environment,
# tag convention, package name, and release controls.

name: Publish approved memoriesQL package

on:
  push:
    tags: ["FINAL_RELEASE_TAG_PATTERN"]

permissions:
  contents: read

jobs:
  build:
    if: github.repository == 'FINAL_PUBLIC_REPOSITORY'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          fetch-depth: 0
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: "3.13"
      - name: Build and inspect reviewed artifacts
        run: |
          python -m pip install --disable-pip-version-check -r requirements-dev.txt
          python scripts/generate_catalogs.py --check
          export SOURCE_DATE_EPOCH=315532800
          python -m build --outdir dist
          python scripts/normalize_python_sdist.py dist/memoriesql-0.0.1a1.tar.gz
          python -m twine check --strict dist/*
          python scripts/inspect_python_distribution.py dist
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: memoriesql-python-${{ github.sha }}
          path: dist/*
          if-no-files-found: error

  publish:
    needs: build
    if: github.repository == 'FINAL_PUBLIC_REPOSITORY'
    runs-on: ubuntu-latest
    environment: FINAL_PYPI_ENVIRONMENT
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          name: memoriesql-python-${{ github.sha }}
          path: dist
      - uses: pypa/gh-action-pypi-publish@dc37677b2e1c63e2034f94d8a5b11f265b73ba33
        with:
          packages-dir: dist
          print-hash: true
