            "maxLength": 256,
            "minLength": 1,
            "title": "Owner Display Name",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "owner_display_name",
          "expires_at",
          "exact_initialization_confirmed"
        ],
        "title": "InitializePersonalLocal",
        "type": "object"
      },
