      "connector_id": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "title": "Connector Id",
        "type": "string"
      },
      "contract_version": {
        "const": 1,
        "default": 1,
        "title": "Contract Version",
        "type": "integer"
