        "type": "string"
      },
      "source_bytes_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Source Bytes Sha256",
        "type": "string"
      },
      "source_revision_key": {
        "maxLength": 512,
        "minLength": 1,
        "title": "Source Revision Key",
