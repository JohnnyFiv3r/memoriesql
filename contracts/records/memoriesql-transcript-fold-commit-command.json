        "required": [
          "source_range_receipt_id",
          "receipt_byte_start",
          "receipt_byte_end_exclusive",
          "receipt_payload_sha256",
          "byte_start",
          "byte_end_exclusive",
          "source_bytes_sha256"
        ],
        "title": "TranscriptFoldSourceRange",
        "type": "object"
      },
      "TranscriptPolicyDisposition": {
        "additionalProperties": false,
        "properties": {
          "disposition_code": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "title": "Disposition Code",
            "type": "string"
          },
          "scope_reason": {
            "anyOf": [
              {
                "$ref": "#/$defs/ScopeExclusionReason"
