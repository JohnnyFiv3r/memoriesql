          "source_object_id",
          "source_revision_key",
          "file_identity_key",
          "byte_start",
          "byte_end_exclusive",
          "start_record_index",
          "end_record_index",
          "source_bytes_sha256"
        ],
        "title": "TranscriptSpanEvidence",
        "type": "object"
