{
  "contract": {
    "$defs": {
      "ExactTurnFoldEvidence": {
        "additionalProperties": false,
        "description": "The unchanged canonical exact-turn result, retained without applying it.",
        "properties": {
          "envelope_canonical_json": {
            "maxLength": 1048576,
            "minLength": 2,
            "title": "Envelope Canonical Json",
            "type": "string"
          },
          "envelope_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Envelope Sha256",
            "type": "string"
          }
        },
        "required": [
          "envelope_canonical_json",
          "envelope_sha256"
        ],
        "title": "ExactTurnFoldEvidence",
        "type": "object"
      },
      "FileIdentity": {
        "additionalProperties": false,
        "properties": {
          "birth_time_ns": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Birth Time Ns"
          },
          "device": {
            "minimum": 0,
            "title": "Device",
            "type": "integer"
          },
          "inode": {
            "minimum": 0,
            "title": "Inode",
            "type": "integer"
          },
          "platform": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Platform",
            "type": "string"
          }
        },
        "required": [
          "platform",
          "device",
          "inode"
        ],
        "title": "FileIdentity",
        "type": "object"
      },
      "KernelCaptureBinding": {
        "additionalProperties": false,
        "description": "Authority resolved by the kernel, never from adapter envelope fields.",
        "properties": {
          "access_scope_id": {
            "format": "uuid",
            "title": "Access Scope Id",
            "type": "string"
          },
          "expected_source_object_schema_version": {
            "minimum": 1,
            "title": "Expected Source Object Schema Version",
            "type": "integer"
          },
          "source_object_id": {
            "format": "uuid",
            "title": "Source Object Id",
            "type": "string"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "workspace_id",
          "access_scope_id",
          "source_object_id",
          "expected_source_object_schema_version"
        ],
        "title": "KernelCaptureBinding",
        "type": "object"
      },
      "LegacyAdapterCursorBinding": {
        "additionalProperties": false,
        "properties": {
          "acknowledged_byte_offset": {
            "exclusiveMinimum": 0,
            "title": "Acknowledged Byte Offset",
            "type": "integer"
          },
          "acknowledged_record_index": {
            "minimum": 0,
            "title": "Acknowledged Record Index",
            "type": "integer"
          },
          "checkpoint_sequence": {
            "minimum": 0,
            "title": "Checkpoint Sequence",
            "type": "integer"
          },
          "cursor_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Cursor Sha256",
            "type": "string"
          },
          "cursor_version": {
            "enum": [
              1,
              2
            ],
            "title": "Cursor Version",
            "type": "integer"
          },
          "last_receipt_event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Last Receipt Event Id"
          }
        },
        "required": [
          "cursor_version",
          "cursor_sha256",
          "acknowledged_byte_offset",
          "acknowledged_record_index",
          "checkpoint_sequence"
        ],
        "title": "LegacyAdapterCursorBinding",
        "type": "object"
      },
      "ScopeExclusionReason": {
        "enum": [
          "off_date",
          "missing_source_time",
          "cross_midnight"
        ],
        "title": "ScopeExclusionReason",
        "type": "string"
      },
      "TranscriptFoldCheckpoint": {
        "additionalProperties": false,
        "properties": {
          "checkpoint_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Checkpoint Hash",
            "type": "string"
          },
          "checkpoint_key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "title": "Checkpoint Key",
            "type": "string"
          },
          "expected_sequence": {
            "minimum": 0,
            "title": "Expected Sequence",
            "type": "integer"
          },
          "next_sequence": {
            "minimum": 1,
            "title": "Next Sequence",
            "type": "integer"
          }
