            "title": "Content Storage",
            "type": "string"
          },
          "end_record_index": {
            "exclusiveMinimum": 0,
            "title": "End Record Index",
            "type": "integer"
          },
          "file_identity_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "File Identity Key",
            "type": "string"
          },
          "source_bytes_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Bytes Sha256",
            "type": "string"
          },
          "source_object_id": {
            "format": "uuid",
            "title": "Source Object Id",
            "type": "string"
          },
          "source_revision_key": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Source Revision Key",
            "type": "string"
          },
          "start_record_index": {
            "minimum": 0,
            "title": "Start Record Index",
            "type": "integer"
          },
          "topology_status": {
            "const": "unknown",
            "default": "unknown",
