    "required": [
      "idempotency_key",
      "binding",
      "capability_id",
      "connector_id",
      "source_revision_key",
      "file_identity",
      "file_identity_key",
      "byte_start",
      "byte_end_exclusive",
      "start_record_index",
      "end_record_index",
      "complete_record_count",
      "source_bytes_sha256",
      "outcomes_sha256",
      "outcomes",
      "checkpoint"
