      "TranscriptFoldOutcome": {
        "additionalProperties": false,
        "properties": {
          "byte_end_exclusive": {
            "exclusiveMinimum": 0,
            "title": "Byte End Exclusive",
            "type": "integer"
          },
          "byte_start": {
            "minimum": 0,
            "title": "Byte Start",
            "type": "integer"
          },
          "end_record_index": {
            "minimum": 0,
            "title": "End Record Index",
            "type": "integer"
          },
          "exact_turn": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExactTurnFoldEvidence"
