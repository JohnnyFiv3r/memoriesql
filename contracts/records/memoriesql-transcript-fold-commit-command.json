            "minimum": 0,
            "title": "Receipt Byte Start",
            "type": "integer"
          },
          "receipt_payload_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Receipt Payload Sha256",
            "type": "string"
          },
          "source_bytes_sha256": {
            "pattern": "^[a-f0-9]{64}$",
