        "properties": {
          "byte_end_exclusive": {
            "exclusiveMinimum": 0,
            "title": "Byte End Exclusive",
            "type": "integer"
          },
          "byte_start": {
            "minimum": 0,
            "title": "Byte Start",
            "type": "integer"
          },
          "receipt_byte_end_exclusive": {
            "exclusiveMinimum": 0,
            "title": "Receipt Byte End Exclusive",
            "type": "integer"
