{
  "contract": {
    "$defs": {
      "ExactTurnFoldEvidence": {
        "additionalProperties": false,
        "description": "The unchanged canonical exact-turn result, retained without applying it.",
        "properties": {
          "envelope_canonical_json": {
            "maxLength": 1048576,
            "minLength": 2,
            "title": "Envelope Canonical Json",
            "type": "string"
          },
          "envelope_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Envelope Sha256",
            "type": "string"
          }
        },
        "required": [
          "envelope_canonical_json",
          "envelope_sha256"
        ],
        "title": "ExactTurnFoldEvidence",
        "type": "object"
      },
      "ScopeExclusionReason": {
        "enum": [
          "off_date",
          "missing_source_time",
          "cross_midnight"
        ],
        "title": "ScopeExclusionReason",
        "type": "string"
      },
      "TranscriptFoldOutcomeKind": {
        "enum": [
          "exact_turn",
          "transcript_span",
          "policy_disposition"
        ],
        "title": "TranscriptFoldOutcomeKind",
        "type": "string"
      },
      "TranscriptFoldSourceRange": {
        "additionalProperties": false,
        "description": "One exact retained-range slice contributing to a fold outcome.",
        "properties": {
          "byte_end_exclusive": {
            "exclusiveMinimum": 0,
            "title": "Byte End Exclusive",
            "type": "integer"
          },
          "byte_start": {
            "minimum": 0,
            "title": "Byte Start",
            "type": "integer"
          },
          "receipt_byte_end_exclusive": {
            "exclusiveMinimum": 0,
            "title": "Receipt Byte End Exclusive",
            "type": "integer"
          },
          "receipt_byte_start": {
            "minimum": 0,
            "title": "Receipt Byte Start",
            "type": "integer"
          },
          "receipt_payload_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Receipt Payload Sha256",
            "type": "string"
          },
          "source_bytes_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Bytes Sha256",
            "type": "string"
          },
          "source_range_receipt_id": {
            "format": "uuid",
            "title": "Source Range Receipt Id",
            "type": "string"
          }
        },
        "required": [
          "source_range_receipt_id",
          "receipt_byte_start",
          "receipt_byte_end_exclusive",
          "receipt_payload_sha256",
          "byte_start",
          "byte_end_exclusive",
          "source_bytes_sha256"
        ],
        "title": "TranscriptFoldSourceRange",
        "type": "object"
      },
      "TranscriptPolicyDisposition": {
        "additionalProperties": false,
        "properties": {
          "disposition_code": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "title": "Disposition Code",
            "type": "string"
          },
          "scope_reason": {
            "anyOf": [
              {
                "$ref": "#/$defs/ScopeExclusionReason"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "disposition_code"
        ],
        "title": "TranscriptPolicyDisposition",
        "type": "object"
      },
      "TranscriptSpanEvidence": {
        "additionalProperties": false,
        "description": "Minimal evidence record for complete records with unknown topology.",
        "properties": {
          "byte_end_exclusive": {
            "exclusiveMinimum": 0,
            "title": "Byte End Exclusive",
            "type": "integer"
          },
          "byte_start": {
            "minimum": 0,
            "title": "Byte Start",
            "type": "integer"
          },
          "content_storage": {
            "const": "retained_source_ranges",
            "default": "retained_source_ranges",
            "title": "Content Storage",
            "type": "string"
          },
          "end_record_index": {
            "exclusiveMinimum": 0,
            "title": "End Record Index",
            "type": "integer"
          },
          "file_identity_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "File Identity Key",
            "type": "string"
          },
          "source_bytes_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Bytes Sha256",
            "type": "string"
          },
          "source_object_id": {
            "format": "uuid",
            "title": "Source Object Id",
            "type": "string"
          },
          "source_revision_key": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Source Revision Key",
            "type": "string"
          },
          "start_record_index": {
            "minimum": 0,
            "title": "Start Record Index",
            "type": "integer"
          },
          "topology_status": {
            "const": "unknown",
            "default": "unknown",
            "title": "Topology Status",
            "type": "string"
          },
          "transcript_span_version": {
            "const": 1,
            "default": 1,
            "title": "Transcript Span Version",
            "type": "integer"
          }
        },
        "required": [
          "source_object_id",
          "source_revision_key",
          "file_identity_key",
          "byte_start",
          "byte_end_exclusive",
          "start_record_index",
          "end_record_index",
          "source_bytes_sha256"
        ],
        "title": "TranscriptSpanEvidence",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "byte_end_exclusive": {
        "exclusiveMinimum": 0,
        "title": "Byte End Exclusive",
        "type": "integer"
      },
      "byte_start": {
        "minimum": 0,
        "title": "Byte Start",
        "type": "integer"
      },
      "end_record_index": {
        "minimum": 0,
        "title": "End Record Index",
        "type": "integer"
      },
      "exact_turn": {
        "anyOf": [
          {
            "$ref": "#/$defs/ExactTurnFoldEvidence"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "lineage": {
        "items": {
          "$ref": "#/$defs/TranscriptFoldSourceRange"
        },
        "maxItems": 1024,
        "minItems": 1,
        "title": "Lineage",
        "type": "array"
      },
      "outcome_kind": {
        "$ref": "#/$defs/TranscriptFoldOutcomeKind"
      },
      "policy_disposition": {
        "anyOf": [
          {
            "$ref": "#/$defs/TranscriptPolicyDisposition"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "source_bytes_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Source Bytes Sha256",
        "type": "string"
      },
      "start_record_index": {
        "minimum": 0,
        "title": "Start Record Index",
        "type": "integer"
      },
      "transcript_span": {
        "anyOf": [
          {
            "$ref": "#/$defs/TranscriptSpanEvidence"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "outcome_kind",
      "byte_start",
      "byte_end_exclusive",
      "start_record_index",
      "end_record_index",
      "source_bytes_sha256",
      "lineage"
    ],
    "title": "TranscriptFoldOutcome",
    "type": "object"
  },
  "id": "memoriesql.transcript-fold.outcome",
  "status": "available",
  "summary": "Versioned SQL-13 capture contract implemented by PR-02M.",
  "version": "1"
}
