                "default": null
              }
            },
            "required": [
              "outcome",
              "proposal_alignment"
            ],
            "title": "ClassificationDecision",
            "type": "object"
          },
          "ClassificationEvidenceReference": {
            "additionalProperties": false,
            "properties": {
              "selection": {
                "$ref": "#/$defs/ReadSourceEvidence"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Sha256",
                "type": "string"
              }
            },
            "required": [
              "selection",
              "sha256"
            ],
            "title": "ClassificationEvidenceReference",
            "type": "object"
          },
          "ClassificationScore": {
            "additionalProperties": false,
            "properties": {
              "score": {
                "maximum": 1,
