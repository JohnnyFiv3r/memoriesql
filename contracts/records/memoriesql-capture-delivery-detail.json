          "client_id": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "title": "Client Id",
            "type": "string"
          },
          "client_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Version",
            "type": "string"
          },
          "model_name": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Name"
          },
          "provider_name": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
