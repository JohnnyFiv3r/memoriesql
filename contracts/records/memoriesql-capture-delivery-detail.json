            "maximum": 1000000,
            "minimum": 0,
            "title": "Source Items Emitted",
            "type": "integer"
          },
          "source_items_quarantined": {
            "maximum": 1000000,
            "minimum": 0,
            "title": "Source Items Quarantined",
            "type": "integer"
          },
          "source_items_seen": {
            "maximum": 1000000,
            "minimum": 0,
            "title": "Source Items Seen",
            "type": "integer"
