            "maxItems": 32,
            "title": "Outcomes",
            "type": "array"
          },
          "resume_after": {
            "anyOf": [
              {
                "$ref": "#/$defs/FoldOutcomeKey"
              },
              {
                "type": "null"
              }
            ]
