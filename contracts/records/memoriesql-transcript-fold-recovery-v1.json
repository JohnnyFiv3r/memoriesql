{
  "contract": {
    "authorization": "Current source.raw.read resource, capability, role and delegation checks before and after the existing authority fence; service access requires explicit policy and grant.",
    "continuation": "Source-scoped immutable receipt watermark and last outcome key; continue within the watermark, then fresh discovery after resume_after to include later committed receipts. Positions are recovery order, not source chronology.",
    "creates_semantic_artifacts": false,
    "evidence": "Hex encodes exact byte pages, including Unicode boundaries. Exact envelopes are normalized stored facts; raw lineage is distinct. Neither implies source completeness, qualification or author exposure.",
    "limits": {
      "discovery_outcomes": 32,
      "lineage_ranges": 16,
      "lock_timeout_ms": 500,
      "operation_timeout_ms": 2000,
      "read_bytes": 32768,
      "request_json_bytes": 8192,
      "response_json_bytes": 131072
    },
    "schemas": {
      "DiscoverFoldOutcomes": {
        "$defs": {
          "FoldDiscoveryCursor": {
            "additionalProperties": false,
            "description": "An immutable source-scoped high water mark and last delivered outcome.",
            "properties": {
              "after": {
                "$ref": "#/$defs/FoldOutcomeKey"
              },
              "through_receipt_id": {
                "format": "uuid",
                "title": "Through Receipt Id",
                "type": "string"
              }
            },
            "required": [
              "through_receipt_id",
              "after"
            ],
            "title": "FoldDiscoveryCursor",
            "type": "object"
          },
          "FoldOutcomeKey": {
            "additionalProperties": false,
            "properties": {
              "fold_receipt_id": {
                "format": "uuid",
                "title": "Fold Receipt Id",
                "type": "string"
              },
              "outcome_ordinal": {
                "maximum": 255,
                "minimum": 0,
                "title": "Outcome Ordinal",
                "type": "integer"
              },
              "source_object_id": {
                "format": "uuid",
                "title": "Source Object Id",
                "type": "string"
              }
            },
            "required": [
              "source_object_id",
              "fold_receipt_id",
              "outcome_ordinal"
            ],
            "title": "FoldOutcomeKey",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "after": {
            "anyOf": [
              {
                "$ref": "#/$defs/FoldOutcomeKey"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "continuation": {
            "anyOf": [
              {
                "$ref": "#/$defs/FoldDiscoveryCursor"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "contract_version": {
            "const": 1,
            "default": 1,
            "title": "Contract Version",
            "type": "integer"
          },
          "limit": {
            "default": 32,
            "maximum": 32,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "operation": {
            "const": "discover",
            "default": "discover",
            "title": "Operation",
            "type": "string"
          },
          "source_object_id": {
            "format": "uuid",
            "title": "Source Object Id",
            "type": "string"
          }
        },
        "required": [
          "source_object_id"
        ],
        "title": "DiscoverFoldOutcomes",
        "type": "object"
      },
