            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "title": "Parser Id",
            "type": "string"
          },
          "parser_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Parser Version",
            "type": "string"
          },
          "source_items_emitted": {
            "maximum": 1000000,
            "minimum": 0,
            "title": "Source Items Emitted",
            "type": "integer"
          },
          "source_items_quarantined": {
            "maximum": 1000000,
            "minimum": 0,
            "title": "Source Items Quarantined",
            "type": "integer"
          },
          "source_items_seen": {
            "maximum": 1000000,
            "minimum": 0,
            "title": "Source Items Seen",
            "type": "integer"
          },
          "status": {
            "$ref": "#/$defs/ParserCoverageStatus"
