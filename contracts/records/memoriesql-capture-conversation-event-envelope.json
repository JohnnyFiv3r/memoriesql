          "capture_policy_id": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "title": "Capture Policy Id",
            "type": "string"
          },
          "observation_unit_policy_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Observation Unit Policy Version",
            "type": "string"
          },
          "retention_policy_ref": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Retention Policy Ref",
            "type": "string"
          }
        },
        "required": [
          "capture_policy_id",
          "access_policy_ref",
          "retention_policy_ref",
          "observation_unit_policy_version"
