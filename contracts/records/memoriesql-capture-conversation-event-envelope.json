      "CanonicalAttribute": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Key",
            "type": "string"
          },
          "value": {
            "maxLength": 512,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "title": "CanonicalAttribute",
        "type": "object"
      },
      "CapturePolicyReferences": {
        "additionalProperties": false,
        "properties": {
          "access_policy_ref": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Access Policy Ref",
            "type": "string"
