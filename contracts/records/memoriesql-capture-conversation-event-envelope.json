          "severity": {
            "$ref": "#/$defs/ParserDiagnosticSeverity"
          }
        },
        "required": [
          "code",
          "severity"
        ],
        "title": "ParserDiagnostic",
        "type": "object"
      },
      "ParserDiagnosticSeverity": {
        "enum": [
          "info",
          "warning",
          "error"
        ],
        "title": "ParserDiagnosticSeverity",
        "type": "string"
      },
      "ParserOmission": {
        "additionalProperties": false,
