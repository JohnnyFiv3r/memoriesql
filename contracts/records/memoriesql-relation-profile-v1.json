{
  "contract": {
    "layers": "Predicate: the registered relation type revision with its exact meaning. Family: navigation and presentation only. Basis: each assertion's own propositions, evidence and qualification.",
    "profile": {
      "attribution": "The Semantic Spacetime family codes, readings and arrow aliases come from Mark Burgess's SSTorytime (Apache-2.0) at commit 039f61003c9b4a93fff88e5ef3be4071ac27db72, and from Burgess, Agent Semantics, Semantic Spacetime, and Graphical Reasoning, arXiv:2506.07756v2 sections 2.2-2.3. The upstream name of the third family is EXPRESS (configuration keyword properties). memoriesQL's definitions are its own; no SSTorytime code or configuration is copied or depended on.",
      "definitions_revision": 1,
      "families": [
        {
          "family": "NEAR",
          "magnitude": 0
        },
        {
          "family": "LEADSTO",
          "magnitude": 1
        },
        {
          "family": "CONTAINS",
          "magnitude": 2
        },
        {
          "family": "EXPRESS",
          "magnitude": 3
        }
      ],
      "mappings": [
        {
          "family": null,
          "key": "supports",
          "mapping_status": "native_unresolved",
          "note": "Upstream's support arrow (LT-1:114) means operational service support and is not a mapping.",
          "orientation": null,
          "upstream_anchor": null
        },
        {
          "family": null,
          "key": "contradicts",
          "mapping_status": "native_unresolved",
          "note": "Upstream contrast and opposition arrows do not express incompatibility.",
          "orientation": null,
          "upstream_anchor": null
        },
        {
          "family": "LEADSTO",
          "key": "caused_by",
          "mapping_status": "established",
          "note": null,
          "orientation": -1,
          "upstream_anchor": "causes / cause-by, LT-1:51"
        },
        {
          "family": "LEADSTO",
          "key": "led_to",
          "mapping_status": "provisional",
          "note": "Upstream's generic leads-to also means plain sequence, so the anchor is results-in.",
          "orientation": 1,
          "upstream_anchor": "result / result-of, LT-1:60"
        },
        {
          "family": "LEADSTO",
          "key": "enables",
          "mapping_status": "established",
          "note": null,
          "orientation": 1,
          "upstream_anchor": "enables / enabled-by, LT-1:66"
        },
        {
          "family": "CONTAINS",
          "key": "part_of",
          "mapping_status": "established",
          "note": null,
          "orientation": -2,
          "upstream_anchor": "has-pt / pt-of, CN-2:18"
        },
        {
          "family": "LEADSTO",
          "key": "depends_on",
          "mapping_status": "provisional",
          "note": "Upstream's depends-on is the inverse of an operational sustains arrow, so it is not the anchor.",
          "orientation": -1,
          "upstream_anchor": "is prereq / has prereq, LT-1:79"
        },
        {
          "family": "LEADSTO",
          "key": "blocks",
          "mapping_status": "provisional_local_extension",
          "note": "No upstream equivalent; nearest constr, LT-1:96. Upstream models inhibition as negated arrows, so this is a local LEADSTO extension.",
          "orientation": 1,
          "upstream_anchor": null
        },
        {
          "family": null,
          "key": "derived_from",
          "mapping_status": "unresolved",
          "note": "Unresolved between a process derivation (derive-fr, LEADSTO -1) and a source attribution (source, EXPRESS +3); the choice depends on what the endpoints represent.",
          "orientation": null,
          "upstream_anchor": "derive-fr, LT-1:18; source, EP-3:47"
        },
        {
          "family": null,
          "key": "supersedes",
          "mapping_status": "intentionally_native",
          "note": "Upstream repl (LT-1:65) runs new to old inside LEADSTO, which is the flattening this profile avoids.",
          "orientation": null,
          "upstream_anchor": null
        },
        {
          "family": "NEAR",
          "key": "associated_with",
          "mapping_status": "established",
          "note": "Upstream clique-completes its NEAR arrows; memoriesQL does not.",
          "orientation": 0,
          "upstream_anchor": "ass, NR-0:47"
        }
      ],
      "profile_revision": 1,
      "rules": [
        "An inverse reading is the same assertion, never a second assertion or independent corroboration. Separately authored assertions are never merged because their readings look inverse.",
        "associated_with and contradicts are symmetric: one assertion covers both directions, and a second one in the other direction adds nothing.",
        "memoriesQL never clique-completes or transitively infers relations. A path through several relations is an investigation route, not a new assertion, and a containment or provenance hop never extends a causal claim.",
        "No temporal predicate exists; chronology stays in time and source-order facilities. No EXPRESS predicate is added only to fill that family.",
        "LEADSTO predicates connect statements describing occurrences, actions, decisions or changing states. A report or hypothesis about a cause is not itself the cause.",
        "An assertion that references itself is always refused. For a key whose cycles are forbidden (part_of, derived_from, supersedes), a write is refused when that key's active assertions, as they would stand once the write commits, would form a cycle between statements."
      ],
      "upstream_commit": "039f61003c9b4a93fff88e5ef3be4071ac27db72"
    },
    "schemas": {
      "FamilyCode": {
        "additionalProperties": false,
        "properties": {
          "family": {
            "enum": [
              "NEAR",
              "LEADSTO",
              "CONTAINS",
              "EXPRESS"
            ],
            "title": "Family",
            "type": "string"
          },
          "magnitude": {
            "maximum": 3,
            "minimum": 0,
            "title": "Magnitude",
            "type": "integer"
          }
        },
        "required": [
          "family",
          "magnitude"
        ],
        "title": "FamilyCode",
        "type": "object"
      },
      "RelationFamilyMapping": {
        "additionalProperties": false,
        "description": "How one built-in predicate maps to a family; the predicate's meaning is unchanged.",
        "properties": {
          "family": {
            "anyOf": [
              {
                "enum": [
                  "NEAR",
                  "LEADSTO",
                  "CONTAINS",
                  "EXPRESS"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family"
          },
          "key": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Key",
            "type": "string"
          },
          "mapping_status": {
            "enum": [
              "established",
              "provisional",
              "provisional_local_extension",
              "unresolved",
              "native_unresolved",
              "intentionally_native"
            ],
            "title": "Mapping Status",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Note"
          },
          "orientation": {
            "anyOf": [
              {
                "enum": [
                  -3,
                  -2,
                  -1,
                  0,
                  1,
                  2,
                  3
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Orientation"
          },
          "upstream_anchor": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Upstream Anchor"
          }
        },
        "required": [
          "key",
          "family",
          "orientation",
          "mapping_status"
        ],
        "title": "RelationFamilyMapping",
        "type": "object"
      },
      "RelationSemanticProfile": {
        "$defs": {
          "FamilyCode": {
